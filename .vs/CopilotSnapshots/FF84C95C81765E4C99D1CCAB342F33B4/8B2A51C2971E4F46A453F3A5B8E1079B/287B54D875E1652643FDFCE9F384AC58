@{
    ViewData["Title"] = "Коли";
}

<div class="cars-hero-section">
    <div class="home-overlay"></div>
    <div class="home-content">
        <h1 class="home-title">Нашите автомобили</h1>
        <p class="home-description">
            Разгледайте нашата впечатляваща колекция от качествени употребявани автомобили. Всяка кола е внимателно подбрана и проверена.
        </p>
    </div>
</div>

<div class="featured-vehicles">
    <div class="featured-header">
        <h2 class="featured-title">Налични автомобили</h2>
        <p class="featured-subtitle">Разгледайте нашата пълна колекция от качествени употребявани автомобили</p>
    </div>

    <div class="vehicles-grid">
        <div class="vehicle-card">
            <div class="vehicle-image">
                <img src="https://images.unsplash.com/photo-1583121274602-3e2820c69888?w=600&q=80" alt="Ferrari">
            </div>
            <div class="vehicle-info">
                <h3 class="vehicle-name">Ferrari</h3>
                <p class="vehicle-details">
                    <span><i class="fa-solid fa-calendar"></i> 2020</span>
                    <span><i class="fa-solid fa-road"></i> 45,000 км</span>
                    <span><i class="fa-solid fa-gas-pump"></i> Дизел</span>
                </p>
                <div class="vehicle-footer">
                    <span class="vehicle-price">525,500 лв</span>
                    <a asp-controller="Home" asp-action="News" class="vehicle-btn">Детайли</a>
                </div>
            </div>
        </div>

        <div class="vehicle-card">
            <div class="vehicle-image">
                <img src="https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?w=600&q=80" alt="Audi">
