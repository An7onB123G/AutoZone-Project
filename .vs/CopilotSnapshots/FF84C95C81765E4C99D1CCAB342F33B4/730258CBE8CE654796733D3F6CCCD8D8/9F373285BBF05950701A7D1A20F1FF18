using System.Diagnostics;
using AutoZone.Data;
using AutoZone.Models;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace AutoZone.Controllers
{
    public class HomeController : Controller
    {
        private readonly ILogger<HomeController> _logger;
        private readonly ApplicationDbContext _context;

        public HomeController(ILogger<HomeController> logger, ApplicationDbContext context)
        {
            _logger = logger;
            _context = context;
        }

        public async Task<IActionResult> Index()
        {
            var featuredVehicles = await _context.Vehicles
                .Include(v => v.BrandModels)
                .Include(v => v.EngineTypes)
                .OrderBy(v => Guid.NewGuid())
                .Take(3)
                .ToListAsync();

            return View(featuredVehicles);
        }

        public IActionResult About()
        {
            return View();
        }

        public async Task<IActionResult> Cars()
        {
            var vehicles = await _context.Vehicles
                .Include(v => v.BrandModels)
                .Include(v => v.EngineTypes)
                .Include(v => v.CarTypes)
                .OrderByDescending(v => v.RegisterOn)
                .ToListAsync();

            return View(vehicles);
        }

        public IActionResult Contacts()
        {
            return View();
        }

        public IActionResult News()
        {
            return View();
        }

        public IActionResult Privacy()
        {
            return View();
        }

        [ResponseCache(Duration = 0, Location = ResponseCacheLocation.None, NoStore = true)]
        public IActionResult Error()
        {
            return View(new ErrorViewModel { RequestId = Activity.Current?.Id ?? HttpContext.TraceIdentifier });
        }
    }
}
