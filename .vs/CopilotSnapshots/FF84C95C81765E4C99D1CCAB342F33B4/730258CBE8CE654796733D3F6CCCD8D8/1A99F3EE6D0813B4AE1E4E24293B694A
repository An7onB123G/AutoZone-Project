using System.Diagnostics;
using AutoZone.Data;
using AutoZone.Models;
using AutoZone.Models.ViewModels;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Rendering;
using Microsoft.EntityFrameworkCore;

namespace AutoZone.Controllers
{
    public class HomeController : Controller
    {
        private readonly ILogger<HomeController> _logger;
        private readonly ApplicationDbContext _context;

        public HomeController(ILogger<HomeController> logger, ApplicationDbContext context)
        {
            _logger = logger;
            _context = context;
        }

        public async Task<IActionResult> Index()
        {
            var featuredVehicles = await _context.Vehicles
                .Include(v => v.BrandModels)
                .Include(v => v.EngineTypes)
                .OrderBy(v => Guid.NewGuid())
                .Take(3)
                .ToListAsync();

            return View(featuredVehicles);
        }

        public IActionResult About()
        {
            return View();
        }

        public async Task<IActionResult> Cars(
            string? search,
            int? brandModelId,
            int? carTypeId,
            int? engineTypeId,
            int? yearFrom,
            int? yearTo,
            int? mileageFrom,
            int? mileageTo,
            decimal? priceFrom,
            decimal? priceTo,
            bool? isAutomatic,
            string? sort,
            int page = 1)
        {
            const int pageSize = 10;
            var query = _context.Vehicles
                .Include(v => v.BrandModels)
                .Include(v => v.EngineTypes)
                .Include(v => v.CarTypes)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(search))
            {
                var term = search.Trim();
                query = query.Where(v => v.BrandModels.Brand.Contains(term) ||
                                         v.BrandModels.Model.Contains(term) ||
                                         v.Description.Contains(term) ||
                                         v.Country.Contains(term));
            }

            if (brandModelId.HasValue)
            {
                query = query.Where(v => v.BrandModelId == brandModelId);
            }

            if (carTypeId.HasValue)
            {
                query = query.Where(v => v.CarTypeId == carTypeId);
            }

            if (engineTypeId.HasValue)
            {
                query = query.Where(v => v.EngineTypeId == engineTypeId);
            }

            if (yearFrom.HasValue)
            {
                query = query.Where(v => v.Year >= yearFrom);
            }

            if (yearTo.HasValue)
            {
                query = query.Where(v => v.Year <= yearTo);
            }

            if (mileageFrom.HasValue)
            {
                query = query.Where(v => v.Mileage >= mileageFrom);
            }

            if (mileageTo.HasValue)
            {
                query = query.Where(v => v.Mileage <= mileageTo);
            }

            if (priceFrom.HasValue)
            {
                query = query.Where(v => v.Price >= priceFrom);
            }

            if (priceTo.HasValue)
            {
                query = query.Where(v => v.Price <= priceTo);
            }

            if (isAutomatic.HasValue)
            {
                query = query.Where(v => v.IsAutomatic == isAutomatic);
            }

            query = sort switch
            {
                "priceAsc" => query.OrderBy(v => v.Price),
                "priceDesc" => query.OrderByDescending(v => v.Price),
                "yearDesc" => query.OrderByDescending(v => v.Year),
                "mileageAsc" => query.OrderBy(v => v.Mileage),
                "mileageDesc" => query.OrderByDescending(v => v.Mileage),
                _ => query.OrderByDescending(v => v.RegisterOn)
            };

            var totalCount = await query.CountAsync();
            var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
            var currentPage = Math.Clamp(page, 1, Math.Max(totalPages, 1));

            var vehicles = await query
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();

            var model = new CarsPageViewModel
            {
                Vehicles = vehicles,
                BrandModelOptions = await _context.BrandModels
                    .OrderBy(b => b.Brand)
                    .ThenBy(b => b.Model)
                    .Select(b => new SelectListItem
                    {
                        Value = b.Id.ToString(),
                        Text = $"{b.Brand} {b.Model}"
                    })
                    .ToListAsync(),
                CarTypeOptions = await _context.CarTypes
                    .OrderBy(c => c.Name)
                    .Select(c => new SelectListItem
                    {
                        Value = c.Id.ToString(),
                        Text = c.Name
                    })
                    .ToListAsync(),
                EngineTypeOptions = await _context.EngineTypes
                    .OrderBy(e => e.Name)
                    .Select(e => new SelectListItem
                    {
                        Value = e.Id.ToString(),
                        Text = e.Name
                    })
                    .ToListAsync(),
                Search = search,
                BrandModelId = brandModelId,
                CarTypeId = carTypeId,
                EngineTypeId = engineTypeId,
                YearFrom = yearFrom,
                YearTo = yearTo,
                MileageFrom = mileageFrom,
                MileageTo = mileageTo,
                PriceFrom = priceFrom,
                PriceTo = priceTo,
                IsAutomatic = isAutomatic,
                Sort = sort,
                PageNumber = currentPage,
                TotalPages = totalPages,
                PageSize = pageSize
            };

            return View(model);
        }

        public IActionResult Contacts()
        {
            return View();
        }

        public IActionResult News()
        {
            return View();
        }

        public IActionResult Privacy()
        {
            return View();
        }

        [ResponseCache(Duration = 0, Location = ResponseCacheLocation.None, NoStore = true)]
        public IActionResult Error()
        {
            return View(new ErrorViewModel { RequestId = Activity.Current?.Id ?? HttpContext.TraceIdentifier });
        }
    }
}
