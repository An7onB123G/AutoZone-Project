@model AutoZone.Models.ViewModels.CarsPageViewModel
@{
    ViewData["Title"] = "Коли";
}

<div class="cars-hero-section">
    <div class="home-overlay"></div>
    <div class="home-content">
        <h1 class="home-title">Нашите автомобили</h1>
        <p class="home-description">
            Разгледайте нашата впечатляваща колекция от качествени употребявани автомобили. Всяка кола е внимателно подбрана и проверена.
        </p>
    </div>
</div>

<div class="featured-vehicles">
    <div class="featured-header">
        <h2 class="featured-title">Налични автомобили</h2>
        <p class="featured-subtitle">Разгледайте нашата пълна колекция от качествени употребявани автомобили</p>
    </div>

    <form method="get" class="cars-filter-card">
        <div class="cars-filter-grid">
            <div class="cars-filter-field">
                <label>Търсене</label>
                <input type="text" name="search" value="@Model.Search" placeholder="Марка, модел, държава, описание" />
            </div>
            <div class="cars-filter-field">
                <label>Марка и модел</label>
                <select name="brandModelId">
                    <option value="">Всички</option>
                    @foreach (var option in Model.BrandModelOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.BrandModelId?.ToString() ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="cars-filter-field">
                <label>Тип автомобил</label>
                <select name="carTypeId">
                    <option value="">Всички</option>
                    @foreach (var option in Model.CarTypeOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.CarTypeId?.ToString() ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="cars-filter-field">
                <label>Двигател</label>
                <select name="engineTypeId">
                    <option value="">Всички</option>
                    @foreach (var option in Model.EngineTypeOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.EngineTypeId?.ToString() ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="cars-filter-field">
                <label>Година от</label>
                <input type="number" name="yearFrom" value="@Model.YearFrom" placeholder="2015" />
            </div>
            <div class="cars-filter-field">
                <label>Година до</label>
                <input type="number" name="yearTo" value="@Model.YearTo" placeholder="2025" />
            </div>
            <div class="cars-filter-field">
                <label>Километри от</label>
                <input type="number" name="mileageFrom" value="@Model.MileageFrom" placeholder="0" />
            </div>
            <div class="cars-filter-field">
                <label>Километри до</label>
                <input type="number" name="mileageTo" value="@Model.MileageTo" placeholder="200000" />
            </div>
            <div class="cars-filter-field">
                <label>Цена от</label>
                <input type="number" name="priceFrom" value="@Model.PriceFrom" placeholder="0" step="0.01" />
            </div>
            <div class="cars-filter-field">
                <label>Цена до</label>
                <input type="number" name="priceTo" value="@Model.PriceTo" placeholder="100000" step="0.01" />
            </div>
            <div class="cars-filter-field">
                <label>Скоростна кутия</label>
                <select name="isAutomatic">
                    <option value="">Всички</option>
                    <option value="true" selected="@(Model.IsAutomatic == true ? "selected" : null)">Автоматична</option>
                    <option value="false" selected="@(Model.IsAutomatic == false ? "selected" : null)">Ръчна</option>
                </select>
            </div>
            <div class="cars-filter-field">
                <label>Сортиране</label>
                <select name="sort">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Sort) ? "selected" : null)">Най-нови</option>
                    <option value="priceAsc" selected="@(Model.Sort == "priceAsc" ? "selected" : null)">Цена (възходящо)</option>
                    <option value="priceDesc" selected="@(Model.Sort == "priceDesc" ? "selected" : null)">Цена (низходящо)</option>
                    <option value="yearDesc" selected="@(Model.Sort == "yearDesc" ? "selected" : null)">Година (нови)</option>
                    <option value="mileageAsc" selected="@(Model.Sort == "mileageAsc" ? "selected" : null)">Километри (възходящо)</option>
                    <option value="mileageDesc" selected="@(Model.Sort == "mileageDesc" ? "selected" : null)">Километри (низходящо)</option>
                </select>
            </div>
        </div>
        <div class="cars-filter-actions">
            <button type="submit" class="cars-filter-submit">Приложи филтри</button>
            <a asp-action="Cars" asp-controller="Home" class="cars-filter-reset">Изчисти</a>
        </div>
    </form>

    <div class="vehicles-grid">
        @if (Model.Vehicles != null && Model.Vehicles.Any())
        {
            foreach (var vehicle in Model.Vehicles)
            {
                <div class="vehicle-card">
                    <div class="vehicle-image">
                        <img src="@(string.IsNullOrWhiteSpace(vehicle.ImageURL) ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=600&q=80" : vehicle.ImageURL)" alt="@vehicle.BrandModels?.Brand @vehicle.BrandModels?.Model">
                    </div>
                    <div class="vehicle-info">
                        <h3 class="vehicle-name">@vehicle.BrandModels?.Brand @vehicle.BrandModels?.Model</h3>
                        <p class="vehicle-details">
                            <span><i class="fa-solid fa-calendar"></i> @vehicle.Year</span>
                            <span><i class="fa-solid fa-road"></i> @vehicle.Mileage.ToString("N0") км</span>
                            <span><i class="fa-solid fa-gas-pump"></i> @vehicle.EngineTypes?.Name</span>
                        </p>
                        <div class="vehicle-footer">
                            <span class="vehicle-price">@vehicle.Price.ToString("N0") лв</span>
                            <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@vehicle.Id" class="vehicle-btn">Детайли</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="about-intro-card">
                <h2 class="about-main-title">Няма налични автомобили</h2>
                <p class="about-lead">В момента няма активни автомобили с тези критерии. Опитайте с различни филтри.</p>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="cars-pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="Cars"
                   asp-controller="Home"
                   asp-route-page="@i"
                   asp-route-search="@Model.Search"
                   asp-route-brandModelId="@Model.BrandModelId"
                   asp-route-carTypeId="@Model.CarTypeId"
                   asp-route-engineTypeId="@Model.EngineTypeId"
                   asp-route-yearFrom="@Model.YearFrom"
                   asp-route-yearTo="@Model.YearTo"
                   asp-route-mileageFrom="@Model.MileageFrom"
                   asp-route-mileageTo="@Model.MileageTo"
                   asp-route-priceFrom="@Model.PriceFrom"
                   asp-route-priceTo="@Model.PriceTo"
                   asp-route-isAutomatic="@Model.IsAutomatic"
                   asp-route-sort="@Model.Sort"
                   class="cars-page-link @(i == Model.PageNumber ? "active" : "")">@i</a>
            }
        </div>
    }
</div>
