@model AutoZone.Models.Order

@{
    ViewData["Title"] = "Детайли за покупка";
}

<h1>Детайли за покупка</h1>

<div>
    <h4>Order</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Clients)
        </dt>
        <dd class = "col-sm-10">
            @($"{Model.Clients?.FirstName} {Model.Clients?.LastName}")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Vehicle)
        </dt>
        <dd class = "col-sm-10">
            @($"{Model.Vehicle?.BrandModels?.Brand} {Model.Vehicle?.BrandModels?.Model}")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderDate)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Редактирай</a>
        <span>|</span>
    }
    <a asp-action="Index">Назад към списъка</a>
</div>
