@model IEnumerable<AutoZone.Models.Order>

@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Всички поръчки" : "Моите покупки";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Нова покупка</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Clients)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vehicle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    @($"{item.Clients?.FirstName} {item.Clients?.LastName}")
                }
                else
                {
                    <span>Ваша покупка</span>
                }
            </td>
            <td>
                @($"{item.Vehicle?.BrandModels?.Brand} {item.Vehicle?.BrandModels?.Model}")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактирай</a>
                    <span>|</span>
                }
                <a asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                @if (User.IsInRole("Admin"))
                {
                    <span>|</span>
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтрий</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
