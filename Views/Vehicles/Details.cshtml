@model AutoZone.Models.Vehicle

@{
    ViewData["Title"] = $"{Model.BrandModels?.Brand} {Model.BrandModels?.Model}";
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageURL)
        ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1200&q=80"
        : Model.ImageURL;
    var transmission = Model.IsAutomatic ? "Автоматична" : "Ръчна";
}

<section class="vehicle-details-page">
    <div class="vehicle-details-hero">
        <div class="vehicle-details-media">
            <img src="@imageUrl" alt="@Model.BrandModels?.Brand @Model.BrandModels?.Model" />
            <span class="vehicle-details-badge">@Model.CarTypes?.Name</span>
        </div>

        <div class="vehicle-details-summary">
            <a asp-controller="Home" asp-action="Cars" asp-fragment="cars-list" class="vehicle-back-link">
                <i class="fa-solid fa-arrow-left"></i>
                Назад към колите
            </a>

            <p class="vehicle-details-kicker">Каталожен номер @Model.CatalogNumber</p>
            <h1>@Model.BrandModels?.Brand @Model.BrandModels?.Model</h1>
            <p class="vehicle-details-subtitle">
                @Model.Year г. · @Model.EngineTypes?.Name · @transmission
            </p>

            <div class="vehicle-details-price">@Model.Price.ToString("N0") лв</div>

            <div class="vehicle-details-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Orders" asp-action="Create" asp-route-vehicleId="@Model.Id" class="vehicle-primary-action">
                        <i class="fa-solid fa-cart-shopping"></i>
                        Купи
                    </a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="vehicle-primary-action">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Влез за покупка
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="vehicle-admin-action">Редактирай</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="vehicle-admin-action danger">Изтрий</a>
                }
            </div>
        </div>
    </div>

    <div class="vehicle-details-grid">
        <article class="vehicle-spec-card">
            <i class="fa-solid fa-calendar"></i>
            <span>Година</span>
            <strong>@Model.Year</strong>
        </article>
        <article class="vehicle-spec-card">
            <i class="fa-solid fa-road"></i>
            <span>Пробег</span>
            <strong>@Model.Mileage.ToString("N0") км</strong>
        </article>
        <article class="vehicle-spec-card">
            <i class="fa-solid fa-gauge-high"></i>
            <span>Мощност</span>
            <strong>@Model.Power к.с.</strong>
        </article>
        <article class="vehicle-spec-card">
            <i class="fa-solid fa-gas-pump"></i>
            <span>Двигател</span>
            <strong>@Model.EngineTypes?.Name</strong>
        </article>
        <article class="vehicle-spec-card">
            <i class="fa-solid fa-gears"></i>
            <span>Скорости</span>
            <strong>@transmission</strong>
        </article>
        <article class="vehicle-spec-card">
            <i class="fa-solid fa-location-dot"></i>
            <span>Произход</span>
            <strong>@Model.Country</strong>
        </article>
    </div>

    <section class="vehicle-description-panel">
        <div>
            <p class="vehicle-details-kicker">Описание</p>
            <h2>Подробности за автомобила</h2>
        </div>
        <p>@Model.Description</p>
    </section>
</section>
