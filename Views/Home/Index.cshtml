@model IEnumerable<AutoZone.Models.Vehicle>
@{
    ViewData["Title"] = "Начало";
}

<div class="home-section">
    <div class="home-overlay"></div>
    <div class="home-content">
        <h1 class="home-title">
            Намерете вашата перфектна<br>
            <span class="home-highlight">употребявана кола</span>
        </h1>
        <p class="home-description">
            Открийте качествени употребявани автомобили на конкурентни цени. Всяка кола е прегледана и сертифицирана за вашето спокойствие.
        </p>

        <div class="home-buttons">
            <a asp-controller="Home" asp-action="Cars" class="home-btn home-btn-primary">
                Разгледайте коли
                <i class="fa-solid fa-arrow-right"></i>
            </a>
            <a asp-controller="Home" asp-action="Contacts" class="home-btn home-btn-secondary">
                Свържете се с нас
            </a>
        </div>

        <div class="home-stats">
            <div class="stat-item">
                <p class="stat-number">500+</p>
                <p class="stat-label">Налични коли</p>
            </div>
            <div class="stat-item">
                <p class="stat-number">10k+</p>
                <p class="stat-label">Доволни клиенти</p>
            </div>
            <div class="stat-item">
                <p class="stat-number">15+</p>
                <p class="stat-label">Години опит</p>
            </div>
        </div>
    </div>
</div>

<div class="featured-vehicles">
    <div class="featured-header">
        <h2 class="featured-title">Препоръчани превозни средства</h2>
        <p class="featured-subtitle">Открийте нашите най-популярни и качествени употребявани автомобили</p>
    </div>

    <div class="vehicles-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var vehicle in Model)
            {
                <div class="vehicle-card">
                    <div class="vehicle-image">
                        <img src="@(string.IsNullOrWhiteSpace(vehicle.ImageURL) ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=600&q=80" : vehicle.ImageURL)" alt="@vehicle.BrandModels?.Brand @vehicle.BrandModels?.Model">
                    </div>
                    <div class="vehicle-info">
                        <h3 class="vehicle-name">@vehicle.BrandModels?.Brand @vehicle.BrandModels?.Model</h3>
                        <p class="vehicle-details">
                            <span><i class="fa-solid fa-calendar"></i> @vehicle.Year</span>
                            <span><i class="fa-solid fa-road"></i> @vehicle.Mileage.ToString("N0") км</span>
                            <span><i class="fa-solid fa-gas-pump"></i> @vehicle.EngineTypes?.Name</span>
                        </p>
                        <div class="vehicle-footer">
                            <span class="vehicle-price">@vehicle.Price.ToString("N0") лв</span>
                            <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@vehicle.Id" class="vehicle-btn">Детайли</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="about-intro-card">
                <h2 class="about-main-title">Няма налични автомобили</h2>
                <p class="about-lead">Добави автомобили в базата, за да се покажат като препоръчани.</p>
            </div>
        }
    </div>
</div>
