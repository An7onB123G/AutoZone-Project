@using Microsoft.AspNetCore.Identity
@using AutoZone.Models
@inject SignInManager<Client> SignInManager
@inject UserManager<Client> UserManager

<ul class="navbar-nav az-auth-list">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link az-auth-cart" asp-area="" asp-controller="Orders" asp-action="Index" title="Моите поръчки">
            <i class="fa-solid fa-cart-shopping"></i>
            <span>Моите поръчки</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link az-auth-user" asp-area="Identity" asp-page="/Account/Manage/Index" title="Профил">@User.Identity?.Name</a>
    </li>
    <li class="nav-item">
        <form class="az-auth-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link az-auth-button">Изход</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link az-auth-secondary" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
    </li>
    <li class="nav-item">
        <a class="nav-link az-auth-primary" asp-area="Identity" asp-page="/Account/Login">Вход</a>
    </li>
}
</ul>
