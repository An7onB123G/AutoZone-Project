@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<section class="auth-page auth-login-page">
    <div class="auth-shell">
        <aside class="auth-side-panel">
            <p class="auth-side-kicker">Auto Zone</p>
            <h2>Влез в своя профил и продължи към любимите автомобили</h2>
            <p>
                Управлявай поръчките си, следи последните обяви и получавай по-бърз достъп до важната информация за нашите предложения.
            </p>
            <ul>
                <li><i class="fa-solid fa-circle-check"></i> Сигурен достъп до твоя профил</li>
                <li><i class="fa-solid fa-circle-check"></i> Бързо и удобно управление</li>
                <li><i class="fa-solid fa-circle-check"></i> Модерна и ясна среда</li>
            </ul>
        </aside>

        <div class="auth-card">
            <h1>@ViewData["Title"]</h1>
            <p class="auth-subtitle">Добре дошли отново! Въведи данните си за достъп.</p>

            <form id="account" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.UserName" class="form-label">Потребителско име</label>
                    <input asp-for="Input.UserName" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="Въведи потребителско име" />
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password" class="form-label">Парола</label>
                    <input asp-for="Input.Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" placeholder="Въведи парола" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <label asp-for="Input.RememberMe" class="auth-check-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    Запомни ме
                </label>

                <button id="login-submit" type="submit" class="auth-submit-btn">Вход</button>

                <div class="auth-links">
                    <a id="forgot-password" asp-page="./ForgotPassword">Забравена парола?</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Нямаш профил? Регистрирай се</a>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Изпрати отново имейл за потвърждение</a>
                </div>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-external">
                    <p>Или влез с:</p>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="auth-external-btn" name="provider" value="@provider.Name" title="Вход с @provider.DisplayName">@provider.DisplayName</button>
                        }
                    </form>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
