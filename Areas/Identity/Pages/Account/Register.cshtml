@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<section class="auth-page auth-register-page">
    <div class="auth-shell">
        <aside class="auth-side-panel">
            <p class="auth-side-kicker">Присъедини се към Auto Zone</p>
            <h2>Създай профил за по-бърз достъп до всичко важно</h2>
            <p>
                Регистрирай се, за да следиш автомобилите, да изпращаш запитвания и да управляваш активността си от едно място.
            </p>
            <ul>
                <li><i class="fa-solid fa-circle-check"></i> Персонализирано изживяване</li>
                <li><i class="fa-solid fa-circle-check"></i> Бърз достъп до запитвания и поръчки</li>
                <li><i class="fa-solid fa-circle-check"></i> Защитен акаунт с модерна визия</li>
            </ul>
        </aside>

        <div class="auth-card auth-card-wide">
            <h1>@ViewData["Title"]</h1>
            <p class="auth-subtitle">Попълни данните по-долу и започни още сега.</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="auth-fields-grid">
                    <div class="auth-field">
                        <label asp-for="Input.UserName" class="form-label">Потребителско име</label>
                        <input asp-for="Input.UserName" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="Потребителско име" />
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Email" class="form-label">Имейл</label>
                        <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="example@mail.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.PhoneNumber" class="form-label">Телефон</label>
                        <input asp-for="Input.PhoneNumber" class="form-control auth-input" autocomplete="tel" aria-required="true" placeholder="08XXXXXXXX" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.FirstName" class="form-label">Име</label>
                        <input asp-for="Input.FirstName" class="form-control auth-input" autocomplete="given-name" aria-required="true" placeholder="Име" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.LastName" class="form-label">Фамилия</label>
                        <input asp-for="Input.LastName" class="form-control auth-input" autocomplete="family-name" aria-required="true" placeholder="Фамилия" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Password" class="form-label">Парола</label>
                        <input asp-for="Input.Password" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="Парола" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="auth-field auth-field-full">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Потвърди парола</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="Повтори паролата" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <button id="registerSubmit" type="submit" class="auth-submit-btn">Създай акаунт</button>
                <div class="auth-links">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Вече имаш акаунт? Влез</a>
                </div>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-external">
                    <p>Или се регистрирай с:</p>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="auth-external-btn" name="provider" value="@provider.Name" title="Регистрация с @provider.DisplayName">@provider.DisplayName</button>
                        }
                    </form>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
